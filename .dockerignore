# Keep the Docker build context small and platform-clean.
# node_modules must never be copied from the host (Windows binaries would
# overwrite the Linux install inside the image).

.git
.github
.gitignore
.env
*.log

frontend/node_modules
frontend/.next
frontend/out
frontend/next-env.d.ts

__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.venv
venv

data/raw
data/silver
data/gold
data/lineage
data/external
!data/demo

mlflow.db
mlruns
mlartifacts
reports/tickets
reports/prediction_log.jsonl
notebooks/.ipynb_checkpoints
docs/.ipynb_checkpoints
