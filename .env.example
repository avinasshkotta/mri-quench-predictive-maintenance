# Copy to .env and fill in. .env is git-ignored — never commit real keys.
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: LangSmith tracing (leave blank to disable)
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=quenchguard

# Optional: email alerts for approved service tickets (leave blank to disable).
# Without SMTP_HOST + TICKET_ALERT_TO the notifier is a no-op.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=alerts@example.com
# SMTP_USE_TLS=1
# TICKET_ALERT_TO=maintenance@example.com,biomed@example.com

# Optional deployment knobs (Week 7 patterns)
# PREDICTION_THRESHOLD=0.90
# MODEL_SOURCE=local            # or "registry" (MLflow @champion, falls back)
# PREDICTION_LOG_PATH=reports/prediction_log.jsonl
# LLM_MAX_TOKENS=1024
