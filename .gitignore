# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Test / lint caches ----
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Generated data (recreate with: python scripts/run_pipeline.py) ----
data/raw/*
data/silver/*
data/gold/*
data/lineage/*
!data/raw/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep

# ---- External datasets (downloaded on demand, not redistributed) ----
data/external/*
!data/external/.gitkeep
!data/external/cmapss/
data/external/cmapss/*
!data/external/cmapss/.gitkeep

# ---- Trained artifacts ----
models/*
!models/.gitkeep

# ---- MLflow experiment store (SQLite metadata + artifact dir, git-ignored) ----
mlflow.db
mlruns/
mlartifacts/

# ---- Agent-generated tickets (runtime artifacts) ----
reports/tickets/
reports/ticket_approved/
reports/ticket_rejected/

# ---- Local env ----
.env
*.log

# ---- OS / editor ----
Thumbs.db
.DS_Store
.idea/
.vscode/
